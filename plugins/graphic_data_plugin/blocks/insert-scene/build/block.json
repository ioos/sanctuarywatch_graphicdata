{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/graphic-data-insert-scene",
  "version": "0.1.0",
  "title": "Graphic Data - Scene",
  "category": "media",
  "description": "Insert a scene into a post",
  "example": {},
  "attributes": {
    "sceneId": {
      "type": "number",
      "default": 0
    },
    "sceneMode": {
      "type": "string",
      "default": "existing"
    },
    "instanceId": {
      "type": "string",
      "default": ""
    },
    "sceneWidth": {
      "type": "number",
      "default": 100
    },
    "sceneWidthUnit": {
      "type": "string",
      "default": "%"
    },
    "sceneMaxWidth": {
      "type": "number",
      "default": 0
    },
    "sceneHeight": {
      "type": "number",
      "default": 0
    },
    "sceneAlignment": {
      "type": "string",
      "default": "center"
    },
    "sceneBackgroundColor": {
      "type": "string",
      "default": "transparent"
    },
    "sceneBorderEnabled": {
      "type": "boolean",
      "default": false
    },
    "sceneBorderColor": {
      "type": "string",
      "default": "#000000"
    },
    "sceneBorderWidth": {
      "type": "number",
      "default": 1
    },
    "sceneBorderRadius": {
      "type": "number",
      "default": 0
    },
    "scenePadding": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "color": {
      "background": false,
      "text": true
    },
    "html": false,
    "typography": {
      "fontSize": true
    }
  },
  "textdomain": "graphic-data-insert-interactive-scene",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./index.css"
}